// Culinary Operations Platform — data model
// One catalog of Items + Recipes shared across the company,
// with Inventory, Order Guides, and Events scoped per Venue.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  STAFF
}

enum EventStatus {
  PLANNED
  CONFIRMED
  COMPLETED
  CANCELLED
}

// Chef's confidence in a festival's assumption-driven forecast. With no
// historical sales yet, forecasts are guesses; this flags how firm they are.
enum ForecastConfidence {
  LOW
  MEDIUM
  HIGH
}

// A scheduled shift is either time worked or an explicit day OFF. A cook with
// no Shift row for a day is simply unscheduled (blank); OFF is a deliberate mark
// (e.g. requested off / rest day) that still prints so the roster reads complete.
enum ShiftKind {
  WORKING
  OFF
}

// Lifecycle of a single prep-order line — one record at two points in time
// (requested, then made). A blank line is never "skipped"; NOT_MADE is explicit.
enum PrepLineStatus {
  REQUESTED // chef submitted, not yet printed
  PRINTED // packet generated, lot assigned (lot frozen here)
  IN_PROGRESS // cook started (optional)
  MADE // back-entered: actual qty, made-by, entered-by
  SHORT // made, but less than requested
  NOT_MADE // explicitly skipped (out of ingredient / time)
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(STAFF)
  homeVenueId  String?
  homeVenue    Venue?   @relation(fields: [homeVenueId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Prep / production ledger
  prepOrders       PrepOrder[]
  prepLinesMade    PrepOrderLine[] @relation("PrepMadeBy")
  prepLinesEntered PrepOrderLine[] @relation("PrepEnteredBy")

  triviaGames TriviaGame[]
}

model Venue {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique // short label e.g. "DT", "WH"
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  inventory     InventoryItem[]
  orderGuides   OrderGuide[]
  events        Event[]
  banquets      Banquet[]
  festivals     Festival[] // festivals hinting at this venue's inventory
  prepLines     PrepOrderLine[] // production destined here
  prepOrders    PrepOrder[] // orders destined here
  cooks         Cook[] // kitchen roster scheduled at this venue
  dayNotes      DayNote[] // DEPRECATED — superseded by dayEvents; kept for backfill/rollback
  dayEvents     DayEvent[] // per-day schedule events (deliveries, off-sites, VIPs…)
  scheduleNotes ScheduleNote[] // per-week posted announcements
}

model Vendor {
  id        String   @id @default(cuid())
  name      String
  contact   String?
  phone     String?
  email     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items       Item[]
  orderGuides OrderGuide[]
}

// Master catalog item / ingredient / purchasable product.
model Item {
  id             String    @id @default(cuid())
  name           String
  category       String    @default("Other")
  unit           String    @default("each") // purchase & count unit, e.g. "lb", "case", "each"
  packSize       String? // descriptive display fallback, e.g. "6 x #10 can"
  // Structured purchasing data for pack-rounded ordering (Festivals order guide
  // and future auto-ordering). Additive & optional so existing rows migrate
  // cleanly; packSize stays as the human-readable fallback.
  packQty        Float? // qty per purchasable pack, e.g. 40
  packUnit       String? // unit of packQty, e.g. "lb" — defaults to `unit` when null
  yieldFactor    Float     @default(1) // finished/raw ratio (e.g. 0.5 smoked brisket); raw need = need / yieldFactor
  unitCost       Float     @default(0) // cost per `unit`; 0 = no price on file
  // Stamped only when unitCost actually changes (not on every edit), so the
  // catalog can show price freshness and flag stale costs for re-quoting.
  priceUpdatedAt DateTime? // null = never priced
  sku            String?
  gcode          String? // Acumatica inventory GCODE for the raw item
  vendorId       String?
  vendor         Vendor?   @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  recipeItems     RecipeItem[]
  inventoryItems  InventoryItem[]
  orderGuideLines OrderGuideLine[]
  festivalOnHand  FestivalOnHand[]

  @@index([category])
}

// A recipe or build. Shared across all venues.
model Recipe {
  id           String  @id @default(cuid())
  name         String
  category     String  @default("Other")
  station      String? // e.g. "Garde Manger", "Bar", "Pastry"
  yieldQty     Float   @default(1)
  yieldUnit    String  @default("servings")
  menuPrice    Float? // sell price per yield unit, for margin calc
  instructions String? // prep steps, plating notes
  photoUrl     String?

  // Production / lot identity (see lib/prep.ts)
  prodCode     String @unique // 3-char auto-generated code used in lot numbers
  holdLifeDays Int? // optional shelf life in days; drives use-by on labels

  // Monotonic edit version, printed on recipe cards so the line can confirm a
  // card is current. One editing session (same user, edits < 30 min apart)
  // counts as one version; bumped in logChange (app/(app)/recipes/actions.ts).
  version Int @default(1)

  // Recipe card / food-safety details (printed for line cooks)
  prepMinutes   Int? // active prep time
  cookMinutes   Int? // cook / bake time
  shelfLife     String? // e.g. "3 days refrigerated"
  storage       String? // storage & holding instructions
  allergens     String? // comma-separated, e.g. "dairy, gluten, tree nuts"
  criticalNotes String? // HACCP / critical control points, e.g. "Cook to 165°F internal"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items         RecipeItem[]
  eventItems    EventMenuItem[]
  banquetItems  BanquetMenuItem[]
  festivalItems FestivalMenuItem[]
  prepLines     PrepOrderLine[]

  // Sub-recipes: a recipe can be built from other recipes (components).
  components RecipeComponent[] @relation("ParentRecipe")
  usedIn     RecipeComponent[] @relation("ChildRecipe")

  // Automatically-recorded edit history.
  changes RecipeChange[]
}

// A recipe used as a component / sub-recipe of another recipe.
// quantity is expressed in the child recipe's yield unit (e.g. 0.5 batch).
model RecipeComponent {
  id       String  @id @default(cuid())
  parentId String
  parent   Recipe  @relation("ParentRecipe", fields: [parentId], references: [id], onDelete: Cascade)
  childId  String
  child    Recipe  @relation("ChildRecipe", fields: [childId], references: [id], onDelete: Restrict)
  quantity Float   @default(1)
  unit     String  @default("serving")
  note     String?

  @@unique([parentId, childId])
  @@index([childId])
}

// Auto-generated changelog entry for a recipe edit.
model RecipeChange {
  id        String   @id @default(cuid())
  recipeId  String
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  summary   String // short headline, e.g. "Edited details"
  detail    String? // newline-separated field-level changes
  version   Int      @default(1) // recipe version this change belongs to (groups a session's edits)
  userId    String?
  userName  String? // snapshot of editor name at the time
  createdAt DateTime @default(now())

  @@index([recipeId, createdAt])
}

model RecipeItem {
  id       String  @id @default(cuid())
  recipeId String
  recipe   Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  itemId   String
  item     Item    @relation(fields: [itemId], references: [id], onDelete: Restrict)
  quantity Float   @default(0) // in the item's unit
  unit     String  @default("each")
  note     String?

  @@unique([recipeId, itemId])
}

// Per-venue current stock with par levels.
model InventoryItem {
  id        String   @id @default(cuid())
  venueId   String
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  itemId    String
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  quantity  Float    @default(0)
  par       Float    @default(0)
  unit      String   @default("each")
  updatedAt DateTime @updatedAt

  @@unique([venueId, itemId])
}

// A vendor order sheet for a venue.
model OrderGuide {
  id        String   @id @default(cuid())
  name      String
  venueId   String
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  vendorId  String?
  vendor    Vendor?  @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines OrderGuideLine[]
}

model OrderGuideLine {
  id           String     @id @default(cuid())
  orderGuideId String
  orderGuide   OrderGuide @relation(fields: [orderGuideId], references: [id], onDelete: Cascade)
  itemId       String
  item         Item       @relation(fields: [itemId], references: [id], onDelete: Restrict)
  par          Float      @default(0)
  unit         String     @default("each")
  sortOrder    Int        @default(0)

  @@unique([orderGuideId, itemId])
}

model Event {
  id         String      @id @default(cuid())
  name       String
  venueId    String
  venue      Venue       @relation(fields: [venueId], references: [id], onDelete: Cascade)
  date       DateTime
  guestCount Int         @default(0)
  status     EventStatus @default(PLANNED)
  location   String?
  notes      String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  menuItems EventMenuItem[]
}

model EventMenuItem {
  id              String  @id @default(cuid())
  eventId         String
  event           Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  recipeId        String
  recipe          Recipe  @relation(fields: [recipeId], references: [id], onDelete: Restrict)
  plannedServings Float   @default(0)
  note            String?

  @@unique([eventId, recipeId])
}

// ---------------------------------------------------------------------------
// Banquets — transcribed Banquet Event Orders (BEOs).
//
// A customer-facing catering order received from sales (contact, service
// window, room, special instructions, setup). Each food line links to a Recipe
// and an ordered quantity; the kitchen view scales every recipe by the ordered
// amount and rolls the dishes up into one aggregated prep / pull sheet.
// Customer pricing and beverage/additional charges are intentionally not
// tracked here — this is the kitchen's production side of the BEO.
// ---------------------------------------------------------------------------
model Banquet {
  id         String      @id @default(cuid())
  name       String // event name on the BEO, e.g. "Miller Wedding"
  venueId    String
  venue      Venue       @relation(fields: [venueId], references: [id], onDelete: Cascade)
  date       DateTime
  timeLabel  String? // free-text service window as printed, e.g. "5:00 pm – 1:00 am"
  guestCount Int         @default(0)
  status     EventStatus @default(PLANNED)
  location   String? // venue / building, e.g. "Foxtown Station"
  areas      String? // room(s) within the venue, e.g. "Opitz Hall"

  // Account / contact block copied from the BEO header (reference only).
  contactName  String?
  contactEmail String?
  contactPhone String?
  salesManager String?

  // Notes transcribed from the BEO.
  specialInstructions String? // multi-line — service notes from the sheet
  setupNotes          String? // multi-line — linen / table setting / setup
  notes               String? // anything else

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  menuItems BanquetMenuItem[]

  @@index([date])
}

// One food line off the BEO: a recipe and the quantity ordered. The recipe is
// scaled by orderedQty (in `unit`, convertible to the recipe's yield unit) to
// drive the aggregated prep/pull sheet. The same recipe may appear more than
// once (e.g. an adult vs. kids portion), so there is no per-recipe uniqueness.
model BanquetMenuItem {
  id          String   @id @default(cuid())
  banquetId   String
  banquet     Banquet  @relation(fields: [banquetId], references: [id], onDelete: Cascade)
  recipeId    String
  recipe      Recipe   @relation(fields: [recipeId], references: [id], onDelete: Restrict)
  orderedQty  Float    @default(0)
  unit        String   @default("servings")
  description String? // BEO line wording / prep note, e.g. "prefers sticks, not promised 5pm"
  createdAt   DateTime @default(now())

  @@index([banquetId])
}

// ---------------------------------------------------------------------------
// Commissary Prep Order & Production Ledger
//
// A chef submits a prep order for a target date; each requested recipe becomes
// a PrepOrderLine. Lines are printed (lots assigned), produced, then
// back-entered with actuals. Mise owns production + transfer truth; Acumatica
// owns raw inventory and authoritative costing.
// ---------------------------------------------------------------------------

// Header: one chef's submission for one production date, bound to a single
// destination venue. Every line inherits this venue — to produce for another
// venue, create a separate order (each venue orders separately).
model PrepOrder {
  id                 String   @id @default(cuid())
  submittedByUserId  String
  submittedBy        User     @relation(fields: [submittedByUserId], references: [id], onDelete: Restrict)
  forDate            DateTime // the production / target date
  // Destination venue for the whole order. Nullable only so existing rows
  // migrate cleanly; the UI requires one before any line can be added.
  destinationVenueId String?
  destinationVenue   Venue?   @relation(fields: [destinationVenueId], references: [id], onDelete: Restrict)
  notes              String?
  createdAt          DateTime @default(now())

  lines PrepOrderLine[]

  @@index([forDate])
  @@index([destinationVenueId])
}

// The spine: one requested recipe → one destination venue. A batch serving two
// venues is two lines on the same recipe with different destinationVenueId
// (combined production, split accounting).
model PrepOrderLine {
  id                 String         @id @default(cuid())
  prepOrderId        String
  prepOrder          PrepOrder      @relation(fields: [prepOrderId], references: [id], onDelete: Cascade)
  recipeId           String
  recipe             Recipe         @relation(fields: [recipeId], references: [id], onDelete: Restrict)
  recipeVersion      Int            @default(1) // snapshot of recipe version at request time
  destinationVenueId String
  destinationVenue   Venue          @relation(fields: [destinationVenueId], references: [id], onDelete: Restrict)
  requestedQty       Float
  requestedUnit      String
  status             PrepLineStatus @default(REQUESTED)

  // Lot — generated at first print, then frozen (immutable). Reprints reuse it.
  lot          String?
  lotPrintedAt DateTime?

  // Production (null until MADE / SHORT / NOT_MADE)
  actualQty       Float?
  actualUnit      String?
  madeByUserId    String? // who physically cooked it (per the packet)
  madeBy          User?     @relation("PrepMadeBy", fields: [madeByUserId], references: [id], onDelete: SetNull)
  madeAt          DateTime?
  enteredByUserId String? // who keyed the back-entry (distinct from madeBy)
  enteredBy       User?     @relation("PrepEnteredBy", fields: [enteredByUserId], references: [id], onDelete: SetNull)
  enteredAt       DateTime?

  // Cost snapshots — frozen when produced, never recomputed against live Catalog.
  unitCostSnapshot Float? // Mise cost per recipe yield unit at time of production
  allocatedCost    Float? // this line's cost share (proportional to qty for splits)
  // Raw-ingredient detail frozen alongside the totals for accounting audit.
  // JSON keeps the historical item name/GCODE/price even if Catalog changes.
  costBreakdownSnapshot Json?

  notes String? // line-level, queryable

  @@index([prepOrderId])
  @@index([recipeId])
  @@index([destinationVenueId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Festivals — Plan-to-Order (V1)
//
// A chef plans food production and ordering for an outdoor festival with tented
// menus (BBQ Tent, Taco Tent, Desserts). With no reliable sales history yet,
// V1 forecasts from assumptions: attendance × capture-rate × per-item mix %,
// with a chef override that wins when entered and a buffer % on top. Final prep
// portions scale recipe builds and roll up into a vendor-grouped order guide
// that applies yield factors, subtracts per-festival on-hand, and rounds up to
// pack size. All derived numbers are computed live (lib/festival.ts) and never
// stored. Percents are stored as fractions 0–1; the UI shows whole %.
// ---------------------------------------------------------------------------
model Festival {
  id                 String             @id @default(cuid())
  name               String
  date               DateTime
  // Optional hint at a venue whose on-site inventory the chef can reference;
  // festivals are off-site so counts live in FestivalOnHand, not InventoryItem.
  venueId            String?
  venue              Venue?             @relation(fields: [venueId], references: [id], onDelete: SetNull)
  expectedAttendance Int                @default(0)
  captureRate        Float              @default(0.35) // fraction of attendance that buys food
  forecastConfidence ForecastConfidence @default(MEDIUM)
  weatherNotes       String?
  bufferPct          Float              @default(0.1) // default prep buffer, fraction; per-item override wins
  // Proposal / accounting assumptions. Food cost and revenue remain live
  // calculations from the menu and linked recipe trees; these are the event
  // costs that cannot be inferred from recipes.
  laborHours         Float              @default(0)
  laborRate          Float              @default(0)
  boothFee           Float              @default(0)
  equipmentCost      Float              @default(0)
  disposablesCost    Float              @default(0)
  transportCost      Float              @default(0)
  otherCost          Float              @default(0)
  salesFeePct        Float              @default(0) // card/commission fees as a fraction of revenue
  targetMarginPct    Float              @default(0.2) // desired net margin as a fraction of revenue
  status             EventStatus        @default(PLANNED)
  notes              String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  tents     FestivalTent[]
  menuItems FestivalMenuItem[]
  onHand    FestivalOnHand[]

  @@index([date])
}

// A tent / station on the festival grounds. A real model (not an enum) so tents
// rename stably, keep an order, and can later drive per-tent prints.
model FestivalTent {
  id         String   @id @default(cuid())
  festivalId String
  festival   Festival @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  name       String
  sortOrder  Int      @default(0)

  menuItems FestivalMenuItem[]

  @@unique([festivalId, name])
}

// One menu line under a tent. A recipe link is optional: forecast-only rows are
// allowed (they still project covers/revenue) but are excluded from scaled
// builds and the order guide, with a warning. Percents are fractions 0–1.
model FestivalMenuItem {
  id                String       @id @default(cuid())
  festivalId        String
  festival          Festival     @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  tentId            String
  tent              FestivalTent @relation(fields: [tentId], references: [id], onDelete: Cascade)
  recipeId          String? // null = forecast-only line; excluded from builds/order guide
  recipe            Recipe?      @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  name              String
  price             Float        @default(0) // menu sell price per portion
  mixPct            Float        @default(0) // fraction of food buyers choosing this item
  chefOverride      Float? // portions; replaces the computed forecast when set
  bufferPctOverride Float? // fraction; null = use the festival default
  sortOrder         Int          @default(0)
  note              String?

  @@index([festivalId])
  @@index([tentId])
}

// Per-festival on-hand count. Festivals are off-site, so the chef counts the
// trailer / walk-in per event rather than trusting a venue's InventoryItem
// (which is shown only as a hint column when venueId is set).
model FestivalOnHand {
  id         String   @id @default(cuid())
  festivalId String
  festival   Festival @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  itemId     String
  item       Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  quantity   Float    @default(0)
  unit       String   @default("each") // defaults to item.unit
  note       String?
  updatedAt  DateTime @updatedAt

  @@unique([festivalId, itemId])
}

// ---------------------------------------------------------------------------
// Weekly Kitchen Schedule
//
// A per-venue roster of cooks and their Mon–Sun shifts, plus per-day notes
// (events, deliveries) and a per-week announcement block. Everything rolls up
// into a printable, postable weekly schedule. Weeks are derived from dates
// (Monday-anchored, UTC) — there is no week header entity, matching how
// Banquets derive their weekly rollup.
// ---------------------------------------------------------------------------

// A member of the kitchen roster who gets scheduled. Distinct from User: cooks
// are people on the line, not app login accounts. Scoped to a venue.
model Cook {
  id        String   @id @default(cuid())
  venueId   String
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  name      String
  role      String? // default station shown under the name, e.g. "Line", "Prep Lead"
  phone     String? // optional — handy on a posted schedule
  active    Boolean  @default(true) // inactive cooks drop off new weeks but keep history
  sortOrder Int      @default(0) // row order on the grid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shifts Shift[]

  @@index([venueId])
}

// One cook's shift on one day. At most one shift per cook per day (a kitchen
// week is one shift/day/cook). start/end are "HH:MM" 24h strings — null on an
// OFF day. role overrides the cook's default station for that shift.
model Shift {
  id        String    @id @default(cuid())
  cookId    String
  cook      Cook      @relation(fields: [cookId], references: [id], onDelete: Cascade)
  date      DateTime // calendar day, UTC midnight (matches Banquet.date)
  kind      ShiftKind @default(WORKING)
  start     String? // "HH:MM" 24h, null for OFF
  end       String? // "HH:MM" 24h, null for OFF
  role      String? // per-shift station, overrides Cook.role
  note      String? // short cell note, e.g. "close", "AM prep only"
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([cookId, date])
  @@index([date])
}

// DEPRECATED: superseded by DayEvent (which allows several events per day).
// Kept in place so the backfill can migrate its rows and so a bad deploy can be
// rolled back without data loss. Safe to drop once DayEvent is confirmed live.
model DayNote {
  id        String   @id @default(cuid())
  venueId   String
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  date      DateTime
  eventName String?
  people    Int?
  time      String?
  location  String?
  body      String?
  updatedAt DateTime @updatedAt

  @@unique([venueId, date])
  @@index([venueId, date])
}

// One event on a single day of the schedule (a delivery, off-site, VIP party).
// A day can hold several, ordered by sortOrder. Replaces DayNote's one-per-day
// limit; the whole day's set is rewritten on each save (see setDayEvents).
model DayEvent {
  id        String   @id @default(cuid())
  venueId   String
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  date      DateTime
  eventName String?
  people    Int?
  time      String?
  location  String?
  body      String? // free-text operational detail
  sortOrder Int      @default(0) // order within the day
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([venueId, date])
}

// The week's posted announcements block (dress code, inventory day, etc.).
// Keyed by the Monday that starts the week. One per venue per week.
model ScheduleNote {
  id        String   @id @default(cuid())
  venueId   String
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  weekStart DateTime
  body      String
  updatedAt DateTime @updatedAt

  @@unique([venueId, weekStart])
}

// ---------------------------------------------------------------------------
// Trivia — live two-player head-to-head game. The host is a logged-in User;
// the guest joins by room code with no account and is identified only by a
// per-player secret token. Timing is server-authoritative: all deadlines are
// stored timestamps, clients merely render countdowns and poll for state.
// ---------------------------------------------------------------------------

enum TriviaGameStatus {
  LOBBY // created, waiting for the second player / host start
  IN_QUESTION // a question is live; countdown running
  REVEAL // answer + round scores shown between questions
  FINISHED
  ABANDONED // ended early by host, or swept after going stale
}

model TriviaGame {
  id                String           @id @default(cuid())
  code              String           @unique // short join code, e.g. "K7QF" (no 0/O/1/I)
  hostUserId        String?
  hostUser          User?            @relation(fields: [hostUserId], references: [id], onDelete: SetNull)
  status            TriviaGameStatus @default(LOBBY)
  categoryId        Int? // OpenTDB category id; null = any category
  categoryName      String?
  difficulty        String? // "easy" | "medium" | "hard" | null = any
  questionCount     Int              @default(10)
  questionSecs      Int              @default(20)
  currentIndex      Int              @default(0)
  // Server-authoritative clocks — clients never decide when time is up.
  questionStartedAt DateTime?
  questionDeadline  DateTime?
  revealDeadline    DateTime?
  rematchCode       String? // set when a rematch game exists; both clients follow it
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  questions TriviaQuestion[]
  players   TriviaPlayer[]

  @@index([status, updatedAt]) // stale-game sweep
}

model TriviaQuestion {
  id           String     @id @default(cuid())
  gameId       String
  game         TriviaGame @relation(fields: [gameId], references: [id], onDelete: Cascade)
  index        Int
  category     String
  difficulty   String
  prompt       String
  answers      String[] // pre-shuffled at creation
  correctIndex Int // never serialized to clients until REVEAL

  playerAnswers TriviaAnswer[]

  @@unique([gameId, index])
}

model TriviaPlayer {
  id         String     @id @default(cuid())
  gameId     String
  game       TriviaGame @relation(fields: [gameId], references: [id], onDelete: Cascade)
  name       String
  isHost     Boolean    @default(false)
  token      String     @unique // random secret; proves identity across polls
  score      Int        @default(0)
  lastSeenAt DateTime   @default(now())

  answers TriviaAnswer[]

  @@index([gameId])
}

model TriviaAnswer {
  id          String         @id @default(cuid())
  playerId    String
  player      TriviaPlayer   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  questionId  String
  question    TriviaQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answerIndex Int
  isCorrect   Boolean
  elapsedMs   Int // server-measured: answeredAt - questionStartedAt
  points      Int
  createdAt   DateTime       @default(now())

  @@unique([playerId, questionId]) // no double answers
}
