# Connection string to your Postgres database.
# Local: postgresql://postgres@localhost:5432/culinary_ops?schema=public
# Cloud (Neon/Supabase/RDS): paste the provider's connection string here.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public&sslmode=require"

# Secret used to sign auth sessions. Generate with: openssl rand -hex 32
AUTH_SECRET="replace-me-with-a-long-random-string"
